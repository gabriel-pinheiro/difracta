{
  "name": "difracta",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "difracta-core",
    "difracta-visuals",
    "difracta-protocol",
    "difracta-client",
    "difracta-runtime",
    "difracta-render",
    "difracta-output",
    "difracta-studio",
    "difracta-cli",
    "difracta-desktop"
  ],
  "scripts": {
    "postinstall": "node scripts/fetch-media.mjs",
    "media:fetch": "node scripts/fetch-media.mjs",
    "dev": "node scripts/fetch-media.mjs && node scripts/dev.mjs",
    "desktop": "node scripts/fetch-media.mjs && npm run build -w @difracta/output -w @difracta/studio -w @difracta/desktop && npm run start -w @difracta/desktop --",
    "package:desktop": "node scripts/fetch-media.mjs && npm run build -w @difracta/output -w @difracta/studio -w @difracta/desktop && npm run package -w @difracta/desktop --",
    "build": "node scripts/fetch-media.mjs && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "test": "vitest run",
    "check": "run-p -l typecheck test lint format:check",
    "test:gpu": "npm run test:gpu -w @difracta/render",
    "test:desktop": "npm run test:desktop -w @difracta/desktop",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "npm-run-all2": "^9.0.3",
    "playwright": "~1.61.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
