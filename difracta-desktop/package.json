{
  "name": "@difracta/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Difracta Desktop: an Electron shell that runs a Runtime on this machine and shows its Studio.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:desktop": "vitest run --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "@difracta/client": "0.0.0",
    "@difracta/core": "0.0.0",
    "@difracta/protocol": "0.0.0",
    "@difracta/runtime": "0.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^44.4.3"
  }
}
